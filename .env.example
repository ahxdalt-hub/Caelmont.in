# ─────────────────────────────────────────────────────────────────────────────
# CAELMONT — environment variables
# Copy to `.env.local` (next dev / next start) or `.dev.vars` (wrangler preview)
# and fill in what you need. Everything here is optional except the Supabase
# pair, without which the contact form falls back to its mailto handoff.
# ─────────────────────────────────────────────────────────────────────────────

# Canonical site URL. Override for staging/preview deployments; production
# default is https://caelmont.in (used for canonical URLs, OG tags, sitemap).
NEXT_PUBLIC_SITE_URL=https://caelmont.in

# Public contact email shown across the site and used by the form's mailto
# fallback. Defaults to Caelmontholding@gmail.com.
NEXT_PUBLIC_CONTACT_EMAIL=

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — Project Settings → API Keys in the Supabase dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Public client credentials. Both are safe to ship to the browser (Row Level
# Security still applies):
#   • Publishable key (`sb_publishable_…`)          — newer projects
#   • Anonymous key (legacy `anon` JWT)             — older projects
# Set whichever your project issues; publishable wins if you set both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. These BYPASS Row Level Security:
#   • Secret key (`sb_secret_…`)                    — newer projects
#   • Service role key (legacy `service_role` JWT)  — older projects
# Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Analytics — optional, privacy-conscious, cookieless providers only.
# Leave NEXT_PUBLIC_ANALYTICS_PROVIDER empty to run with no analytics at all
# (the current state; nothing is loaded and no data leaves the browser).
# When set, the /privacy page updates its disclosure automatically.
#   • "plausible" — set NEXT_PUBLIC_ANALYTICS_DOMAIN (defaults to caelmont.in)
#   • "umami"     — also set the script URL and website ID from your dashboard
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_ANALYTICS_PROVIDER=
NEXT_PUBLIC_ANALYTICS_DOMAIN=caelmont.in
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
