# Public site URL (optional override for canonical URLs / metadata)
NEXT_PUBLIC_SITE_URL=https://caelmont.in

# ─────────────────────────────────────────────────────────────────────────────
# Supabase — copy this file to `.env.local` and fill in the blanks.
# Project Settings → API Keys in the Supabase dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# Public client credentials. Both are safe to ship to the browser (Row Level
# Security still applies):
#   • Publishable key (`sb_publishable_…`)          — newer projects
#   • Anonymous key (legacy `anon` JWT)             — older projects
# Set whichever your project issues; publishable wins if you set both.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only credentials. These BYPASS Row Level Security:
#   • Secret key (`sb_secret_…`)                    — newer projects
#   • Service role key (legacy `service_role` JWT)  — older projects
# Never prefix these with NEXT_PUBLIC_ — that would ship them to the browser.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
